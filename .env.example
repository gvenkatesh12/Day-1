# Copy this file to `.env` and fill in real values.
# `.env` is loaded automatically by conftest.py via python-dotenv.

ORANGEHRM_BASE_URL=https://opensource-demo.orangehrmlive.com
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=admin123

# Optional overrides
# BROWSER=chromium        # chromium | firefox | webkit
# HEADLESS=false          # false | true  (default: false — browser is visible)
# SLOW_MO=0               # milliseconds between Playwright actions
# DEFAULT_TIMEOUT=15000   # per-action timeout in ms
